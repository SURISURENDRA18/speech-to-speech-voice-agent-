# ==============================================================================
# Speech-to-Speech Voice Agent - Environment Configuration Example
# ==============================================================================

# Server configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# Audio parameters
INPUT_SAMPLE_RATE=16000
OUTPUT_SAMPLE_RATE=24000
AUDIO_CHANNELS=1
INPUT_QUEUE_MAXSIZE=100
OUTPUT_QUEUE_MAXSIZE=100
MAX_SPEECH_DURATION_SECONDS=30.0

# Silero VAD v6 configuration
VAD_THRESHOLD=0.5
VAD_NEG_THRESHOLD=0.35
VAD_MIN_SILENCE_DURATION_MS=300
VAD_SPEECH_PAD_MS=30

# Backends / performance
# USE_MLX: Apple Silicon only (quantized Whisper + Qwen via MLX, all resident).
USE_MLX=true
PRELOAD_MODELS=true
# KEEP_MODELS_LOADED: unset = auto (true on CUDA, false for PyTorch on 8 GB Macs)
# KEEP_MODELS_LOADED=true
OVERLAP_LLM_TTS=true
# CLIENT_PLAYBACK_MODE: auto | smooth | fast
CLIENT_PLAYBACK_MODE=auto

# Whisper STT configuration (809M parameters); WHISPER_DEVICE: auto | cuda | mps | cpu
WHISPER_MODEL_NAME=large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=hi
USE_MOCK_STT=false

# Qwen3 1.7B LLM configuration
LLM_MODEL_NAME_OR_PATH=unsloth/Qwen3-1.7B
LLM_DEVICE=auto
LLM_TORCH_DTYPE=bfloat16
# Indic scripts use ~3 tokens per word; below ~100 replies get cut mid-sentence.
LLM_MAX_NEW_TOKENS=128
LLM_TEMPERATURE=0.5
# User/assistant exchanges remembered per session (sent to the LLM every turn)
CONVERSATION_MAX_TURNS=6
# Optional OpenAI-compatible LLM server (vLLM serving Qwen3 on a GPU, see docs/DEPLOY_GCP.md)
# LLM_API_URL=http://qwen:8001
# LLM_API_MODEL=Qwen/Qwen3-1.7B
USE_MOCK_LLM=false
# Leave SYSTEM_PROMPT unset to use the built-in conversational prompt
# (voice_agent/config.py). The reply-language rule is appended automatically.
# SYSTEM_PROMPT="You are a warm, attentive multilingual Indian voice assistant..."

# Indic Text Normalization
NORMALIZATION_ENABLED=true
NORMALIZATION_DEFAULT_LANG=hi

# Svara TTS configuration
SVARA_MODEL_NAME=svara-tts-v1
SVARA_VOICE=hi_female
SVARA_DEVICE=auto
# Remote Svara server (Kenpath/svara-tts-inference on a GPU, see docs/DEPLOY_GCP.md)
# SVARA_API_URL=http://svara:8080
USE_MOCK_TTS=false

# Audio smoothness
# Smallest audio frame sent to the browser; tiny TTS network pieces are merged.
TTS_MIN_FRAME_MS=160
# Without LLM/TTS overlap (8 GB Macs), sentences are merged into TTS requests
# up to this many characters so the voice doesn't restart every sentence.
TTS_MAX_CHARS_PER_REQUEST=220
# With LLM/TTS overlap, up to this many sentences synthesize at once while
# earlier ones play (a GPU Svara server batches them almost for free).
TTS_PARALLEL_REQUESTS=3
# Assumed TTS speed (audio s per s) until measured; Svara on one L4 is ~0.6.
TTS_ASSUMED_REALTIME_FACTOR=0.6
# When TTS is slower than real time, a sentence starts playing only once enough
# is buffered to finish without a gap. Safety factor on its estimated length.
TTS_UNDERRUN_MARGIN=1.2
